# ------------------------------------------------------------------
# Markdown Blog - environment configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# --- Site ---
# Public URL of your blog (used for SEO, sitemap.xml, rss.xml, OpenGraph).
# For local development: http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=My Markdown Blog

# --- Admin credentials (required for the /admin dashboard) ---
ADMIN_USER=admin
# Use a long random password in production!
ADMIN_PASSWORD=change-me-please

# --- Sessions ---
# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Storage paths (advanced) ---
# Where Markdown posts and uploaded images are stored.
# In Docker these are mapped as persistent volumes - see docker-compose.yml.
# POSTS_DIR=./posts
# UPLOADS_DIR=./uploads
